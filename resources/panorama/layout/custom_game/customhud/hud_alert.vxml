<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/customhud/customhud_tokens.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/customhud/hud_alert.vcss_c" />
	</styles>
	<Panel class="chud-root" hittest="false">
		<Panel id="shell" class="chud-alert hidden" hittest="false">
