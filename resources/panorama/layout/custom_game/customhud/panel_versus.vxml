<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/customhud/customhud_tokens.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/customhud/panel_versus.vcss_c" />
	</styles>
	<Panel class="chud-root" hittest="false">
		<Panel id="shell" class="chud-versus hidden" hittest="false">
			<Panel class="chud-versus__bar" hittest="false">
				<Panel class="chud-versus__side chud-versus__side--left" hittest="false">
					<Label class="chud-versus__team" text="{s:team1}" hittest="false" />
					<Label class="chud-versus__score" text="{s:score1}" hittest="false" />
				</Panel>
				<Label class="chud-versus__status" text="{s:status}" hittest="false" />
				<Panel class="chud-versus__side chud-versus__side--right" hittest="false">
					<Label class="chud-versus__score" text="{s:score2}" hittest="false" />
					<Label class="chud-versus__team" text="{s:team2}" hittest="false" />
				</Panel>
			</Panel>
			<Label class="chud-versus__detail" text="{s:detail}" hittest="false" />
		</Panel>
	</Panel>
</root>
