/*
	MapChooser's views on menu_locker. Map shots and logos come from locker_art.vcss
	(econ-<token> on lk-thumb and lk-logo). A map without art gets its prefix as its
	mark and tone (awp_lego_2: "awp"), which pick the stand-in art below.
*/

/* ---- shared: logos on the shot's corner, and the stand-in for maps without art ---- */

.lk.view-maps-board .lk-logo,
.lk.view-maps-rows .lk-logo,
.lk.view-maps-pool .lk-logo,
.lk.view-maps-rtv .lk-logo
{
	width: 28px;
	height: 28px;
	horizontal-align: left;
	vertical-align: top;
	margin: 10px 0px 0px 10px;
	visibility: visible;
}

.lk.view-maps-board .lk-logo.hidden,
.lk.view-maps-rows .lk-logo.hidden,
.lk.view-maps-pool .lk-logo.hidden,
.lk.view-maps-rtv .lk-logo.hidden
{
	visibility: collapse;
}

.lk.view-maps-board .lk-mark,
.lk.view-maps-rows .lk-mark,
.lk.view-maps-pool .lk-mark,
.lk.view-maps-rtv .lk-mark
{
	horizontal-align: left;
	vertical-align: top;
	margin: 0px;
	border-radius: 0px;
	overflow: clip clip;
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudGoldDim ), to( chudTileDeep ) );
}

.lk.view-maps-board .tone-awp .lk-mark, .lk.view-maps-rows .tone-awp .lk-mark,
.lk.view-maps-pool .tone-awp .lk-mark, .lk.view-maps-rtv .tone-awp .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudInfoDim ), to( chudTileDeep ) );
}

.lk.view-maps-board .tone-aim .lk-mark, .lk.view-maps-rows .tone-aim .lk-mark,
.lk.view-maps-pool .tone-aim .lk-mark, .lk.view-maps-rtv .tone-aim .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudDangerDim ), to( chudTileDeep ) );
}

.lk.view-maps-board .tone-surf .lk-mark, .lk.view-maps-rows .tone-surf .lk-mark,
.lk.view-maps-pool .tone-surf .lk-mark, .lk.view-maps-rtv .tone-surf .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudLegendDim ), to( chudTileDeep ) );
}

/* The prefix, huge and faint, cut off by the art's lower edge. */
.lk.view-maps-board .lk-mark__text,
.lk.view-maps-rows .lk-mark__text,
.lk.view-maps-pool .lk-mark__text,
.lk.view-maps-rtv .lk-mark__text
{
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 10px -14px 0px;
	font-size: 76px;
	color: chudGlassSoft;
	letter-spacing: 4px;
}

/* Tags on the shot: its top-right corner, or the top-left where a workshop map has no logo.
   Their colours are the Solid pill look in locker.vcss. */
.lk.view-maps-board .lk-tags,
.lk.view-maps-pool .lk-tags
{
	horizontal-align: right;
	vertical-align: top;
	margin: 10px 10px 0px 0px;
}

.lk.view-maps-board .has-mark .lk-tags,
.lk.view-maps-pool .has-mark .lk-tags
{
	horizontal-align: left;
	margin: 10px 0px 0px 10px;
}

.lk.view-maps-board .lk-tag,
.lk.view-maps-board .lk-tag2,
.lk.view-maps-pool .lk-tag,
.lk.view-maps-pool .lk-tag2
{
	margin: 0px 0px 0px 6px;
	padding: 3px 8px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* ---- maps-board: vote cards, three to a line ---- */

/* 3 x (282 + 8) = 870 of the list's 882. */
.lk.view-maps-board .lk-slot
{
	width: 282px;
	height: 276px;
	margin: 0px 8px 8px 0px;
}

/* The shot fades into the card, so the tile stays one flat colour under it. */
.lk.view-maps-board .lk-list .lk-hit,
.lk.view-maps-board .lk-list .lk-hit:hover,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit:hover
{
	background-color: chudTileDeep;
}

.lk.view-maps-board .tone-extend .lk-hit
{
	border: 1px solid chudAccentDim;
}

.lk.view-maps-board .lk-thumb
{
	width: 100%;
	height: 158px;
	vertical-align: top;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-board .lk-mark
{
	width: 100%;
	height: 158px;
}

/* The shot fades into the card under the map's name. */
.lk.view-maps-board .lk-shade
{
	height: 158px;
	vertical-align: top;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudTileFade ), color-stop( 0.45, chudTileFade ), to( chudTileDeep ) );
	visibility: visible;
}

/* Extend has no map: its art is a glow behind its icon. */
.lk.view-maps-board .tone-extend .lk-shade
{
	background-color: gradient( radial, 50% 60%, 0% 0%, 65% 65%, from( chudAccentDim ), to( chudTileDeep ) );
}

.lk.view-maps-board .lk-glyph
{
	width: 54px;
	height: 54px;
	horizontal-align: center;
	vertical-align: top;
	margin: 50px 0px 0px 0px;
	wash-color: chudAccentBase;
}

.lk.view-maps-board .lk-slot .lk-text
{
	width: 254px;
	vertical-align: top;
	margin: 122px 0px 0px 14px;
}

.lk.view-maps-board .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	text-shadow: 0px 1px 3px 1.0 chudShadowText;
}

.lk.view-maps-board .tone-extend .lk-name
{
	color: chudAccentStrong;
}

.lk.view-maps-board .lk-slot .lk-sub
{
	visibility: collapse;
}

.lk.view-maps-board .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 196px 0px 0px 14px;
	font-size: 12px;
}

.lk.view-maps-board .lk-end
{
	vertical-align: top;
	margin: 172px 14px 0px 0px;
}

.lk.view-maps-board .lk-value
{
	font-size: 38px;
	color: chudTextMain;
}

.lk.view-maps-board .lead .lk-value
{
	color: chudGoldBase;
}

.lk.view-maps-board .lk-meter
{
	width: 254px;
	height: 6px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 0px 40px 14px;
	border-radius: 3px;
	background-color: chudSurfaceRow;
}

.lk.view-maps-board .chud-meter__fill
{
	border-radius: 3px;
}

/* Two lines of cards fill the page; the turnout is in the header's chips. */
.lk.view-maps-board .lk-foot
{
	visibility: collapse;
}

/* ---- maps-rows: one poll row per map, its share filling the row ---- */

.lk.view-maps-rows .lk-slot
{
	height: 74px;
	margin-bottom: 8px;
}

.lk.view-maps-rows .lk-thumb
{
	width: 132px;
	height: 100%;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-rows .lk-logo
{
	width: 24px;
	height: 24px;
	margin: 8px 0px 0px 8px;
}

.lk.view-maps-rows .lk-mark
{
	width: 132px;
	height: 100%;
}

.lk.view-maps-rows .lk-mark__text
{
	margin: 0px 8px -8px 0px;
	font-size: 44px;
}

.lk.view-maps-rows .tone-extend .lk-shade
{
	width: 132px;
	horizontal-align: left;
	background-color: gradient( radial, 50% 60%, 0% 0%, 65% 65%, from( chudAccentDim ), to( chudTileDeep ) );
	visibility: visible;
}

.lk.view-maps-rows .lk-glyph
{
	width: 32px;
	height: 32px;
	margin-left: 50px;
	wash-color: chudAccentBase;
}

/* The share: a fill behind the row from the art's edge, with a bright leading edge. */
.lk.view-maps-rows .lk-meter
{
	width: 748px;
	height: 100%;
	horizontal-align: right;
	vertical-align: top;
	margin: 0px;
	border-radius: 0px;
	background-color: transparent;
}

/* The fill is drawn after the text; z-index keeps the words on top of it. */
.lk.view-maps-rows .lk-text,
.lk.view-maps-rows .lk-tags,
.lk.view-maps-rows .lk-note,
.lk.view-maps-rows .lk-end
{
	z-index: 1;
}

.lk.view-maps-rows .lk-slot .lk-text
{
	width: 420px;
	margin-left: 150px;
}

.lk.view-maps-rows .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rows .tone-extend .lk-name
{
	color: chudAccentStrong;
}

.lk.view-maps-rows .lk-sub
{
	margin-top: 4px;
}

.lk.view-maps-rows .lk-tags
{
	margin-right: 152px;
}

.lk.view-maps-rows .lk-tag,
.lk.view-maps-rows .lk-tag2
{
	padding: 3px 8px;
	font-family: chudFontBody;
	font-weight: bold;
}

.lk.view-maps-rows .lk-end
{
	vertical-align: top;
	margin: 12px 18px 0px 0px;
}

.lk.view-maps-rows .lk-value
{
	font-size: 30px;
	color: chudTextMain;
}

.lk.view-maps-rows .lead .lk-value
{
	color: chudGoldBase;
}

.lk.view-maps-rows .lk-note
{
	vertical-align: top;
	margin: 50px 18px 0px 0px;
}

/* The turnout under the rows: a caption, a pip per player, the time left. */
.lk.view-maps-rows .lk-foot .lk-slot
{
	height: 34px;
	margin: 2px 0px 0px 0px;
}

.lk.view-maps-rows .lk-foot .lk-slot .lk-text
{
	width: 160px;
	margin-left: 4px;
}

.lk.view-maps-rows .lk-foot .lk-pips
{
	width: 617px;
	height: 8px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 164px;
}

.lk.view-maps-rows .lk-foot .lk-pip
{
	margin-right: 4px;
}

.lk.view-maps-rows .lk-foot .lk-note
{
	vertical-align: center;
	margin: 0px 4px 0px 0px;
	font-size: 11px;
}

/* ---- maps-pool: every map as a card, four to a line, 4 x (212 + 6) = 872 of 882 ---- */

.lk.view-maps-pool .lk-slot
{
	width: 212px;
	height: 196px;
	margin: 0px 6px 8px 0px;
}

.lk.view-maps-pool .lk-thumb
{
	width: 100%;
	height: 118px;
	vertical-align: top;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-pool .lk-mark
{
	width: 100%;
	height: 118px;
}

.lk.view-maps-pool .lk-mark__text
{
	font-size: 64px;
}

.lk.view-maps-pool .lk-slot .lk-text
{
	width: 188px;
	vertical-align: top;
	margin: 128px 0px 0px 12px;
}

.lk.view-maps-pool .lk-name
{
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-maps-pool .lk-sub
{
	margin-top: 5px;
}

/* Why a map cannot be picked, on its shot just above its name. */
.lk.view-maps-pool .lk-slot.disabled .lk-tags
{
	horizontal-align: left;
	margin: 88px 0px 0px 8px;
}

/* ---- maps-rtv: the vote's progress in one panel, the nominations beside it ---- */

.lk.view-maps-rtv .lk-col
{
	padding: 30px 32px 28px 32px;
}

.lk.view-maps-rtv .lk-banner .lk-slot
{
	width: 100%;
	height: 262px;
	margin: 0px;
}

/* "9" then "/ 12": the count and its unit share a line whatever their widths. */
.lk.view-maps-rtv .lk-banner .lk-slot .lk-text
{
	width: 100%;
	vertical-align: top;
	margin: 0px;
	flow-children: right-wrap;
}

.lk.view-maps-rtv .lk-banner .lk-type
{
	font-size: 12px;
	color: chudGoldBase;
	letter-spacing: 3px;
}

.lk.view-maps-rtv .lk-banner .lk-name
{
	width: fit-children;
	margin-top: 14px;
	font-family: chudDigitsBold;
	font-size: 104px;
}

.lk.view-maps-rtv .lk-banner .lk-unit
{
	margin: 70px 0px 0px 12px;
	font-family: chudDigitsBold;
	font-size: 44px;
	color: chudTextFaint;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-maps-rtv .lk-banner .lk-sub
{
	margin-top: 6px;
	font-size: 13px;
	letter-spacing: 2px;
}

.lk.view-maps-rtv .lk-banner .lk-pips
{
	height: 14px;
	vertical-align: top;
	margin-top: 195px;
}

.lk.view-maps-rtv .lk-banner .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 224px 0px 0px 0px;
	font-size: 14px;
	letter-spacing: 1px;
}

/* The voters as name chips. */
.lk.view-maps-rtv .lk-list
{
	padding-right: 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot
{
	width: fit-children;
	height: 24px;
	margin: 0px 6px 6px 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot .lk-text
{
	width: fit-children;
	margin: 0px;
}

.lk.view-maps-rtv .lk-list .lk-name
{
	width: fit-children;
	font-size: 12px;
}

.lk.view-maps-rtv .lk-content .lk-slot.section
{
	width: 100%;
	height: 22px;
	margin: 0px 0px 8px 0px;
}

.lk.view-maps-rtv .lk-content .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

.lk.view-maps-rtv .lk-content .lk-slot.section .lk-text
{
	margin: 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot.section .lk-name
{
	font-size: 10px;
	color: chudTextMuted;
	letter-spacing: 2px;
}

/* The player's own state, then the action, at the panel's foot. */
.lk.view-maps-rtv .lk-foot
{
	flow-children: down;
}

.lk.view-maps-rtv .lk-foot .lk-slot
{
	height: 26px;
	margin: 0px;
}

.lk.view-maps-rtv .lk-foot .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 0px;
}

.lk.view-maps-rtv .lk-foot .tone-good .lk-glyph
{
	wash-color: chudSuccessBase;
}

.lk.view-maps-rtv .lk-foot .lk-slot .lk-text
{
	margin-left: 24px;
}

.lk.view-maps-rtv .lk-foot .lk-name
{
	font-family: chudFontMedium;
	font-size: 13px;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rtv .lk-foot .tone-good .lk-name
{
	color: chudSuccessBase;
}

.lk.view-maps-rtv .lk-foot .kind-action
{
	height: 46px;
	margin-top: 12px;
}

.lk.view-maps-rtv .lk-foot .kind-action .lk-text
{
	width: fit-children;
	horizontal-align: center;
	margin-left: 0px;
}

.lk.view-maps-rtv .lk-foot .kind-action .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	letter-spacing: 2px;
}

/* The side: the nominations in one box, the facts in another under it. */
.lk.view-maps-rtv .lk-detail__box,
.lk.view-maps-rtv .lk-detail__body
{
	height: fit-children;
}

.lk.view-maps-rtv .lk-detail__body
{
	padding: 16px;
}

.lk.view-maps-rtv .lk-detail .lk-slot.section .lk-name
{
	color: chudGoldBase;
}

/* The count at the box's right edge. */
.lk.view-maps-rtv .lk-detail .lk-slot.section .lk-text
{
	width: fill-parent-flow( 1.0 );
}

.lk.view-maps-rtv .grp-nomination
{
	height: 54px;
	margin-bottom: 6px;
}

.lk.view-maps-rtv .grp-nomination .lk-thumb
{
	width: 96px;
	height: 100%;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-rtv .grp-nomination .lk-logo
{
	width: 18px;
	height: 18px;
	margin: 6px 0px 0px 6px;
}

.lk.view-maps-rtv .grp-nomination .lk-mark
{
	width: 96px;
	height: 100%;
}

.lk.view-maps-rtv .grp-nomination .lk-mark__text
{
	margin: 0px 6px -6px 0px;
	font-size: 30px;
}

.lk.view-maps-rtv .grp-nomination .lk-text
{
	width: 180px;
	margin-left: 108px;
}

.lk.view-maps-rtv .grp-nomination .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-maps-rtv .grp-more
{
	height: 40px;
}

.lk.view-maps-rtv .grp-more .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 14px;
	wash-color: chudAccentStrong;
}

.lk.view-maps-rtv .grp-more .lk-text
{
	margin-left: 38px;
}

.lk.view-maps-rtv .grp-more .lk-name
{
	font-size: 12px;
	color: chudAccentStrong;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rtv .lk-detail__bar
{
	margin-top: 12px;
	padding: 16px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 44px;
	margin: 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-slot .lk-text
{
	horizontal-align: left;
	vertical-align: top;
	margin: 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-end
{
	horizontal-align: left;
	vertical-align: top;
	margin: 18px 0px 0px 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-value
{
	font-family: chudFontBody;
	font-size: 22px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
}
