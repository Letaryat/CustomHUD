/*
	Ready check (Panels profile "ready"). Variables: title, count, state, hint.
	Classes: is-ready / not-ready on the shell. Requires customhud_tokens.vcss.
*/

.chud-root
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.chud-ready
{
	width: 340px;
	height: fit-children;
	horizontal-align: right;
	vertical-align: top;
	margin: 180px 32px 0px 0px;
	padding: 12px 16px 12px 16px;
	flow-children: down;
	background-color: chudSurfaceBase;
	border-right: 3px solid chudTextFaint;
	border-radius: 6px;
	box-shadow: fill chudShadowDrop 0px 0px 8px 0px;
	opacity: 1;
	transform: translateX( 0px );
	transition-property: opacity, transform, border-right;
	transition-duration: 0.18s;
	transition-timing-function: ease-in-out;
}

.chud-ready.hidden
{
	opacity: 0;
	transform: translateX( 12px );
}

.chud-ready.is-ready
{
	border-right: 3px solid chudSuccessBase;
}

.chud-ready.not-ready
{
	border-right: 3px solid chudDangerBase;
}

.chud-ready__head
{
	width: 100%;
	flow-children: right;
}

.chud-ready__dot
{
	width: 10px;
	height: 10px;
	margin-right: 10px;
	vertical-align: center;
	border-radius: 50%;
	background-color: chudTextFaint;
}

.chud-ready.is-ready .chud-ready__dot
{
	background-color: chudSuccessBase;
}

.chud-ready.not-ready .chud-ready__dot
{
	background-color: chudDangerBase;
}

.chud-ready__title
{
	width: fill-parent-flow( 1.0 );
	font-family: chudFontMedium;
	font-size: 18px;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 1px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.chud-ready__count
{
	font-family: chudDigitsBold;
	font-size: 18px;
	color: chudTextCream;
}

.chud-ready__state
{
	margin-top: 6px;
	font-family: chudFontCondensed;
	font-size: 16px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.chud-ready.is-ready .chud-ready__state
{
	color: chudSuccessBase;
}

.chud-ready.not-ready .chud-ready__state
{
	color: chudDangerBase;
}

.chud-ready__hint
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 13px;
	color: chudTextFaint;
}
